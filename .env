# can find installed models via `ollama list`
MODEL=qwen3.8:27b
#
EMBEDDING_MODEL=bge-m3:latest
# sqlite checkpoint database
SQLITE_DB_PATH=db/checkpoints.sqlite
# ingest.py writes here; promote to MILVUS_PROD_DB once a run is confirmed good
MILVUS_DEV_DB_PATH=db/milvus_dev.db
# search_docs tool reads from here
MILVUS_PROD_DB_PATH=db/milvus_prod.db
#
DENSE_METRIC_TYPE=COSINE
DENSE_INDEX_TYPE=AUTOINDEX
#
SPARSE_METRIC_TYPE=BM25
SPARSE_INDEX_TYPE=SPARSE_INVERTED_INDEX
# the agent's system prompt is read from this file
SYSTEM_PROMPT_PATH=prompts/system.txt
# the prompt handed to the model when it names a conversation for itself
SELF_NAME_PROMPT_PATH=prompts/self_name.txt
# 0 for no reasoning block, 1 to see the reasoning stream
DISPLAY_THINKING=1
#
MAX_TOOL_CALLS=3
# qwen3.8:27B hyperparameters. recommended values for thinking mode from
# https://huggingface.co/Qwen/Qwen3.8-27B
# i just found out through `ollama show qwen3.8:27b` that the model was pulled
# with the recomm parameters anyway, so these are redundant. but ill keep them
# for the sake of doc for now...
IS_REASONING=1
#
TEMPERATURE=1.0
#
TOP_K=20
#
TOP_P=0.95
#
REPETITION_PENALTY=1.0
#
CONTEXT_SIZE=32768