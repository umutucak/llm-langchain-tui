# can find installed models via `ollama list`
MODEL=qwen3.8:27b
# default
SYSTEM_PROMPT=You are an LLM assistant.
# 0 for no reasoning block, 1 to see the reasoning stream
DISPLAY_THINKING=1
#
# qwen3.8:27B hyperparameters. recommended values for thinking mode from
# https://huggingface.co/Qwen/Qwen3.8-27B
IS_REASONING=1
#
TEMPERATURE=1.0
#
TOP_K=20
#
TOP_P=0.95
#
MIN_P=0.0
#
REPETITION_PENALTY=1.0
# below presence penalty not exposed through ChatOllama? still, value here
# https://reference.langchain.com/python/langchain-ollama/chat_models/ChatOllama
PRESENCE_PENALTY=0.0