/* Styling for llmtui/tui.py. Colours come from the active Textual theme so a
   theme switch stays a one-liner rather than a repaint of this file. */

Screen {
    layers: base;
    background: $surface;
}

#chrome {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    border-bottom: solid $panel-lighten-2;
}

#transcript {
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

/* the footer owns the dock; its children just stack inside it */
#footer {
    dock: bottom;
    height: auto;
}

#prompt {
    border: none;
    border-top: solid $panel-lighten-2;
    background: $surface;
    padding: 0 1;
    /* grows a row at a time as the question wraps, then scrolls once it would
       start eating the transcript. the footer keeps it off the status bar. */
    height: auto;
    min-height: 3;
    max-height: 12;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* ---------- turns ---------- */

.turn {
    height: auto;
    margin-bottom: 1;
}

.turn.user {
    color: $primary;
    text-style: bold;
    padding-left: 2;
    border-left: thick $primary;
}

.note {
    color: $text-muted;
    padding-left: 2;
}

.note.stopped { color: $warning; }
.note.failed  { color: $error; }

/* ---------- reasoning ---------- */

.reasoning {
    height: auto;
    border: none;
    background: transparent;
    margin-bottom: 1;
}

.reasoning CollapsibleTitle {
    color: $text-muted;
    text-style: italic;
}

.reasoning-body {
    color: $text-disabled;
    padding: 0 0 0 2;
}

/* ---------- tool rows ---------- */

.toolrow {
    height: auto;
    border: none;
    background: transparent;
    margin: 0;
}

.toolrow Contents {
    padding: 0 0 0 4;
}

.toolrow.-running CollapsibleTitle { color: $warning; }
.toolrow.-ok      CollapsibleTitle { color: $success; }
/* the search ran and found nothing -- a miss, not a fault */
.toolrow.-empty   CollapsibleTitle { color: $warning; }
.toolrow.-error   CollapsibleTitle { color: $error; }

.passages {
    color: $text-muted;
    padding: 1 0;
}

/* ---------- answer ---------- */

.answer {
    height: auto;
    background: transparent;
    margin: 1 0 0 0;
    padding: 0;
}

/* ---------- pending writes ---------- */

.writecard {
    height: auto;
    margin: 1 0;
    padding: 0 1;
    border-left: thick $warning;
    background: transparent;
}

.writecard.-ok    { border-left: thick $success; }
.writecard.-error { border-left: thick $error; }

.writecard:focus-within,
.writecard:focus { background: $boost; }

.write-head    { text-style: bold; color: $warning; }
.writecard.-ok    .write-head { color: $success; }
.writecard.-error .write-head { color: $error; }

.write-summary { color: $text; }
.write-note    { color: $text-muted; text-style: italic; }
.write-hint    { color: $text-muted; }

.diff-body {
    height: auto;
    padding: 0 1;
    background: transparent;
}

.modal-wide { width: 110; }

/* ---------- modals ---------- */

ModalScreen {
    align: center middle;
    background: $background 70%;
}

.modal {
    width: 68;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $primary;
}

.modal-title {
    color: $primary;
    text-style: bold;
    padding-bottom: 1;
}

.modal-hint {
    color: $text-muted;
    padding-top: 1;
}

.modal OptionList,
.modal SelectionList {
    height: auto;
    max-height: 20;
    background: transparent;
    border: none;
}

.modal Input {
    border: none;
    border-bottom: solid $primary;
    background: transparent;
}
